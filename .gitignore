# Pocket Gains .gitignore (keep in sync with .rsync-exclude)
# Third-party clone, envs, caches, archives, Blender backups, scratch renders, secrets
repo-gamedev/
.venv/
venv/
*venv*/
env/
__pycache__/
*.pyc
node_modules/
*.zip
*.blend1
*.blend@
*.tmp
*.part
*~
tmp/
temp/
scratch/
_scratch/
frames/
_frames/
render_tmp/
.env
.env.*
*.env
*.pem
*.key
.DS_Store
# Files >100 MB are also never synced (rsync --max-size=100m)
